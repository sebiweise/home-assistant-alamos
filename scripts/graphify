#!/usr/bin/env bash
# Build the graphify knowledge graph of the code base for Claude Code.
#
# Runs as a Claude Code SessionStart hook (see .claude/settings.json).
# Cloud sessions install the pinned graphify release on demand; local
# sessions only rebuild the graph when graphify is already installed.
# The graph is code-only (local AST parsing, no LLM calls) and written to
# the git-ignored graphify-out/ directory. Never fails the session.
set -uo pipefail

GRAPHIFY_VERSION="0.9.86"

cd "$(dirname "$0")/.." || exit 0

if ! command -v graphify >/dev/null 2>&1; then
  if [ "${CLAUDE_CODE_REMOTE:-}" != "true" ]; then
    exit 0
  fi
  if command -v uv >/dev/null 2>&1; then
    uv tool install --quiet "graphifyy==${GRAPHIFY_VERSION}" >/dev/null 2>&1
  else
    python3 -m pip install --quiet --user "graphifyy==${GRAPHIFY_VERSION}" >/dev/null 2>&1
  fi
  export PATH="${HOME}/.local/bin:${PATH}"
  command -v graphify >/dev/null 2>&1 || exit 0
fi

graphify extract . --code-only >/dev/null 2>&1
graphify cluster-only . --no-label --no-viz >/dev/null 2>&1

if [ -f graphify-out/GRAPH_REPORT.md ]; then
  echo "graphify: knowledge graph ready in graphify-out/ (see CLAUDE.md)."
fi
exit 0
